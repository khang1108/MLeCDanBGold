# The service binds to loopback by default. Keep this value unless a local
# reverse proxy is the only thing that can reach the origin.
SOCKETAPP_HOST=127.0.0.1
SOCKETAPP_PORT=8120

# Use an absolute path in deployments. This default matches the HCMAI project
# layout but the repository currently does not contain source videos.
SOCKETAPP_VIDEO_ROOT=/home/endipi/personal/MLeCDanBGold/data/videos

# Optional. Relative paths are resolved from the current working directory.
# Without a manifest, the service discovers common video extensions recursively
# and uses each filename stem as its video_id.
# SOCKETAPP_MANIFEST=/absolute/path/to/videos.json

# The React development server and a deployed frontend can both be listed.
# A value of * allows any browser origin; it is not an authentication control.
SOCKETAPP_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
SOCKETAPP_MAX_WORKERS=32
SOCKETAPP_REQUEST_TIMEOUT_SECONDS=30
SOCKETAPP_LOG_LEVEL=INFO
