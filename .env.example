HCMAI_INFERENCE_BASE_URL=https://api.iamphuckhang.dev
# Root containing canonical keyframe assets (metadata remains under artifacts/).

HCMAI_DATASET_ROOT=artifacts/custom-raw1fps-v1
HCMAI_METADATA_PATH=artifacts/frame_store/frames.parquet
HCMAI_INDEX_PATH=artifacts/indexes/visual
HCMAI_CONTEXT_INDEX_PATH=artifacts/indexes/context_vi
HCMAI_ASR_SEGMENT_INDEX_PATH=artifacts/indexes/asr_segments
HCMAI_CAPTION_PATH=artifacts/corpus/caption_vi.parquet
HCMAI_OCR_PATH=artifacts/corpus/ocr_frames.parquet
HCMAI_OBJECT_PATH=artifacts/corpus/object_frames.parquet
HCMAI_TRANSCRIPTS_PATH=artifacts/enrichment/transcripts
HCMAI_VIDEO_METADATA_PATH=artifacts/media-info

HCMAI_WORKSPACE_DB=runtime/workspace.sqlite3
HCMAI_CORS_ORIGINS=https://hcmai.iamphuckhang.dev
HCMAI_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|(.+\.)?iamphuckhang\.dev|(.+\.)?iamphuckhnag\.dev)(:\d+)?$

HCMAI_CF_ACCESS_CLIENT_ID=
HCMAI_CF_ACCESS_CLIENT_SECRET=

# TRAKE tuning knobs, shown at their defaults.
HCMAI_TRAKE_TOP_K=500
HCMAI_TRAKE_MAX_VIDEOS=200
HCMAI_TRAKE_RRF_K=60
HCMAI_TRAKE_LAMBDA_GAP=1e-5
HCMAI_TRAKE_EVENT_POWER=1.0
HCMAI_TRAKE_CHUNK_SIZE=65536
HCMAI_TRAKE_CLUSTER_DELTA=0.0

HCMAI_MINICHALLENGE_BASE_URL=http://if-wan4.selab.edu.vn:20740
HCMAI_MINICHALLENGE_TIMEOUT_SECONDS=10
HCMAI_MINICHALLENGE_SESSION_REFRESH_SECONDS=300
DES_USERNAME=
DES_PASSWORD=
HCMAI_CONFIG_PATH=configs/baseline.yaml
HCMAI_LLM_CONFIG=llm/config.yaml

# Integrated local video origin. Leave SOCKETAPP_VIDEO_ROOT blank to disable
# video serving; set it to the directory containing the source videos.
SOCKETAPP_VIDEO_ROOT=
SOCKETAPP_MANIFEST=
SOCKETAPP_ALLOW_EMPTY=false
SOCKETAPP_CACHE_CONTROL=public, max-age=3600
