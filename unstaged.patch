+    mapping_path = output / "frame_mapping.parquet"
+    vectors_partial = vectors_path.with_suffix(f"{vectors_path.suffix}.partial")
+    mapping_partial = mapping_path.with_suffix(f"{mapping_path.suffix}.partial")
+    try:
