HCMAI_INFERENCE_BASE_URL=https://api.iamphuckhang.dev

# =============================================================
# THUNDERCOMPUTE CONTROLLER (OPTIONAL)
# =============================================================
# The token is read from a local secret file, not stored in Compose
# environment or tracked configuration.
TNR_VERSION=2.0.71
TNR_API_TOKEN_FILE=.secrets/tnr_api_token
HCMAI_THUNDER_DEPLOY_SCRIPT=./thundercompute/deploy_cloudflared_private.sh
HCMAI_THUNDER_GPU=l40
HCMAI_THUNDER_TEMPLATE=base
HCMAI_THUNDER_VCPUS=8
HCMAI_THUNDER_DISK_GB=200
HCMAI_THUNDER_WAIT_TIMEOUT_SECONDS=900
HCMAI_THUNDER_POLL_INTERVAL_SECONDS=10
HCMAI_THUNDER_DELETE_ON_EXIT=true

# =============================================================
# LITELLM BLOCK
# =============================================================
# Docker LiteLLM pass-through targets. These are routes, not API secrets.
LITELLM_LOG=INFO
LITELLM_UPSTREAM_READY_URL=https://api.iamphuckhang.dev/ready
LITELLM_UPSTREAM_CAPTIONS_URL=https://api.iamphuckhang.dev/v1/captions
LITELLM_UPSTREAM_OCR_URL=https://api.iamphuckhang.dev/v1/enrichment/ocr
LITELLM_UPSTREAM_TEXT_EMBEDDINGS_URL=https://api.iamphuckhang.dev/v1/embeddings/text
LITELLM_UPSTREAM_IMAGE_EMBEDDINGS_URL=https://api.iamphuckhang.dev/v1/embeddings/images
LITELLM_UPSTREAM_DINO_EMBEDDINGS_URL=https://api.iamphuckhang.dev/v1/embeddings/dino
LITELLM_UPSTREAM_SHOT_SCORES_URL=https://api.iamphuckhang.dev/v1/preprocessing/shot-scores
LITELLM_UPSTREAM_EVENT_SCORES_URL=https://api.iamphuckhang.dev/v1/preprocessing/event-scores
LITELLM_UPSTREAM_EVENT_WINDOW_SCORES_URL=https://api.iamphuckhang.dev/v1/preprocessing/event-window-scores
LITELLM_UPSTREAM_ASR_URL=https://api.iamphuckhang.dev/v1/transcripts/asr
LITELLM_UPSTREAM_DIARIZATION_URL=https://api.iamphuckhang.dev/v1/transcripts/diarization
LITELLM_UPSTREAM_RERANK_URL=https://api.iamphuckhang.dev/v1/rerank
LITELLM_UPSTREAM_QUERY_SUGGESTION=
# Root containing canonical keyframe assets (metadata remains under artifacts/).
HCMAI_DATASET_ROOT=data
HCMAI_METADATA_PATH=artifacts/frame_store/frames.parquet
HCMAI_INDEX_PATH=artifacts/indexes/visual
HCMAI_CF_ACCESS_CLIENT_ID=
HCMAI_CF_ACCESS_CLIENT_SECRET=
HCMAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# TRAKE tuning knobs, shown at their defaults.
HCMAI_TRAKE_TOP_K=500
HCMAI_TRAKE_MAX_VIDEOS=200
HCMAI_TRAKE_RRF_K=60
HCMAI_TRAKE_LAMBDA_GAP=1e-5
HCMAI_TRAKE_EVENT_POWER=1.0
HCMAI_TRAKE_CHUNK_SIZE=65536
HCMAI_TRAKE_CLUSTER_DELTA=0.0

HCMAI_MINICHALLENGE_BASE_URL=http://if-wan4.selab.edu.vn:20740
HCMAI_MINICHALLENGE_TIMEOUT_SECONDS=10
HCMAI_MINICHALLENGE_SESSION_REFRESH_SECONDS=300
DES_USERNAME=
DES_PASSWORD=
