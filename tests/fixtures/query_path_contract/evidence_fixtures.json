{
  "object_evidence_contract": {
    "description": "Distinguishes completed evaluation with 0 objects ({}) from absent or failed evaluation (null).",
    "scenarios": {
      "detected_objects": {
        "raw_counts": {"person": 3, "bicycle": 1},
        "expected_optional": {"person": 3, "bicycle": 1},
        "expected_fallback": {"person": 3, "bicycle": 1},
        "status": "COMPLETED"
      },
      "zero_detected_objects": {
        "raw_counts": {},
        "expected_optional": {},
        "expected_fallback": {},
        "status": "COMPLETED"
      },
      "missing_frame_record": {
        "raw_counts": null,
        "expected_optional": null,
        "expected_fallback": {},
        "status": "NOT_EVALUATED"
      },
      "failed_enrichment": {
        "raw_counts": {},
        "expected_optional": null,
        "expected_fallback": {},
        "status": "FAILED"
      }

    }
  },
  "asr_boundary_contract": {
    "description": "ASR transcript uses half-open interval [start_ms, end_ms). start_ms is inclusive, end_ms is exclusive.",
    "segment": {
      "segment_id": "seg_asr_test_001",
      "video_id": "vid_asr_001",
      "start_ms": 1500,
      "end_ms": 4500,
      "text": "lời thoại trong đoạn video",
      "language": "vi"
    },
    "boundary_probes": [
      {"timestamp_ms": 1499, "expected_match": false, "reason": "Before interval start"},
      {"timestamp_ms": 1500, "expected_match": true, "reason": "Exact start is inclusive"},
      {"timestamp_ms": 3000, "expected_match": true, "reason": "Interior of interval"},
      {"timestamp_ms": 4499, "expected_match": true, "reason": "Just before end is inclusive"},
      {"timestamp_ms": 4500, "expected_match": false, "reason": "Exact end is exclusive"},
      {"timestamp_ms": 5000, "expected_match": false, "reason": "After interval end"}
    ]
  }
}
