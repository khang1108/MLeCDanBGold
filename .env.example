HCMAI_INFERENCE_BASE_URL=https://api.iamphuckhang.dev
HCMAI_CF_ACCESS_CLIENT_ID=
HCMAI_CF_ACCESS_CLIENT_SECRET=
HCMAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# TRAKE tuning knobs, shown at their defaults.
HCMAI_TRAKE_TOP_K=500
HCMAI_TRAKE_MAX_VIDEOS=200
HCMAI_TRAKE_RRF_K=60
HCMAI_TRAKE_LAMBDA_GAP=1e-5
HCMAI_TRAKE_EVENT_POWER=1.0
HCMAI_TRAKE_CHUNK_SIZE=65536
HCMAI_TRAKE_CLUSTER_DELTA=0.0
HCMAI_TRAKE_TEMPORAL_CORE_ENABLED=false

# KIS/VQA temporal core knobs, shown at their defaults.
HCMAI_TEMPORAL_TOP_M=10
HCMAI_TEMPORAL_GLOBAL_QUOTA=100
HCMAI_TEMPORAL_LOCAL_QUOTA=100
HCMAI_TEMPORAL_MAX_SPAN_MS=30000
HCMAI_TEMPORAL_MAX_PER_VIDEO=5
HCMAI_TEMPORAL_MERGE_OVERLAP=0.8
# The four score weights must sum to 1.
HCMAI_TEMPORAL_SEMANTIC_WEIGHT=0.4
HCMAI_TEMPORAL_COVERAGE_WEIGHT=0.3
HCMAI_TEMPORAL_TEMPORAL_WEIGHT=0.15
HCMAI_TEMPORAL_RELATION_WEIGHT=0.15
HCMAI_TEMPORAL_MIN_SCORE_WEIGHT=0.5
HCMAI_TEMPORAL_COMPACT_HALF_LIFE_MS=5000
HCMAI_TEMPORAL_DISCRIMINATIVE_HINT_WEIGHTS=false

HCMAI_MINICHALLENGE_BASE_URL=http://if-wan4.selab.edu.vn:20740
HCMAI_MINICHALLENGE_TIMEOUT_SECONDS=10
HCMAI_MINICHALLENGE_SESSION_REFRESH_SECONDS=300
DES_USERNAME=
DES_PASSWORD=
