#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

# Copy this file to deploy_cloudflared_private.sh and fill in the private
# deployment commands for the GPU VM.  The copied file is ignored by Git and
# uploaded by launch.sh to /home/ubuntu/ only at runtime.
#
# Do not put the Cloudflare tunnel token in docker-compose.yml, .env.example,
# a Dockerfile, or any tracked file.  This file is only a safe contract/example
# and intentionally does not contain credentials or a machine-specific repo URL.

: "${CLOUDFLARE_TUNNEL_TOKEN:?Set CLOUDFLARE_TUNNEL_TOKEN in the private copy.}"

# The private copy should, in order:
#   1. install/update the HCMAI inference checkout and pinned dependencies;
#   2. configure the enabled hcmai.thundercompute server on localhost:8100;
#   3. install/start cloudflared with the private tunnel token;
#   4. verify /health and /ready before returning.
#
# Keep this placeholder command until those private deployment details are
# filled in.  A placeholder must never be used for a real Thunder instance.
printf '%s\n' "Private Cloudflare bootstrap is not configured." >&2
exit 78
